# ============================================================
# E-commerce API  (api/)
# ============================================================

# Base de datos
# SQLite (desarrollo):
DATABASE_URL=sqlite+aiosqlite:///./ecommerce.db
# PostgreSQL (producción — descomenta y ajusta):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ecommerce

# JWT
SECRET_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Servidor
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4           # Gunicorn workers (Linux). En Windows usa 1 con --reload.
API_RELOAD=false        # true solo en desarrollo local

# Subida de archivos
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Pago simulado
PAYMENT_DELAY_MIN_MS=300
PAYMENT_DELAY_MAX_MS=800
PAYMENT_FAILURE_RATE=0.05   # 5% de rechazos aleatorios

# Rate limiting (requests por minuto por IP, 0 = desactivado)
RATE_LIMIT_PER_MINUTE=0

# Entorno
ENVIRONMENT=development     # development | production


# ============================================================
# Load Tester  (load_tester/)
# ============================================================

# URL de la API a testear (IP del servidor en la LAN)
API_BASE_URL=http://192.168.1.100:8000

# Escenario a ejecutar
# Opciones: ramp_up | spike | sustained | combined
SCENARIO=combined

# Concurrencia
MAX_WORKERS=200
TOKEN_POOL_SIZE=50

# Duración total del test en segundos
DURATION_SECONDS=300

# Think time entre pasos de cada flujo (ms)
THINK_TIME_MIN_MS=50
THINK_TIME_MAX_MS=300

# Timeout por request (segundos)
REQUEST_TIMEOUT_S=10

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8001

# Directorio de resultados
RESULTS_DIR=results
