# ============================================================
# E-commerce API  (api/)
# PC Servidor: Intel Core i5-8250U (4C/8T) · 12 GB DDR4
# ============================================================

# Base de datos
# SQLite (desarrollo / benchmark rápido):
DATABASE_URL=sqlite+aiosqlite:///./ecommerce.db
# PostgreSQL (para benchmark de producción — mayor RPS y concurrencia):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ecommerce

# JWT
SECRET_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Servidor
API_HOST=0.0.0.0
API_PORT=8000
# i5-8250U tiene 4 cores físicos → 4 workers es el valor óptimo con Gunicorn.
# Con SQLite no subas de 4 (contención de escritura en disco).
# Con PostgreSQL puedes usar 6-8 workers (2 × núcleos físicos).
API_WORKERS=4
API_RELOAD=false        # true solo en desarrollo local

# Subida de archivos
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Pago simulado
PAYMENT_DELAY_MIN_MS=300
PAYMENT_DELAY_MAX_MS=800
PAYMENT_FAILURE_RATE=0.05   # 5% de rechazos aleatorios

# Rate limiting (requests por minuto por IP, 0 = desactivado)
RATE_LIMIT_PER_MINUTE=0

# Entorno
ENVIRONMENT=development     # development | production


# ============================================================
# Load Tester  (load_tester/)
# PC Cliente: AMD Ryzen 5 5500 (6C/12T) · 24 GB DDR4
# ============================================================

# URL de la API a testear — cambiar 192.168.1.100 por la IP real del servidor.
API_BASE_URL=http://192.168.1.100:8000

# Escenario a ejecutar
# Opciones: ramp_up | spike | sustained | combined
# El escenario "combined" ejecuta ramp_up → sustained → spike en secuencia.
SCENARIO=combined

# Máximo de usuarios virtuales concurrentes.
# Con el i5-8250U como servidor, 100 workers es suficiente para encontrar
# el punto de saturación. Aumenta a 150-200 solo si quieres observar el
# comportamiento por encima de la saturación.
MAX_WORKERS=100

# Usuarios pre-autenticados en el pool de tokens.
# Debe ser <= número de usuarios creados por seed_db.py.
TOKEN_POOL_SIZE=50

# Think time entre pasos de cada flujo (ms)
THINK_TIME_MIN_MS=50
THINK_TIME_MAX_MS=300

# Timeout por request (segundos).
# Con LAN local 5s es suficiente. Sube a 10 si usas red WiFi.
REQUEST_TIMEOUT_S=5

# Dashboard
DASHBOARD_PORT=8001

# Directorio donde se guardan los reportes JSON/CSV al terminar el test
RESULTS_DIR=results

# ── Escenario Ramp-Up ─────────────────────────────────────────────────────────
# Con MAX_WORKERS=100, RAMP_STEP_WORKERS=5, RAMP_STEP_INTERVAL_S=15:
#   Duración: (100-5)/5 × 15s + 15s = 300s (5 minutos exactos hasta el pico)
RAMP_INITIAL_WORKERS=5
RAMP_STEP_WORKERS=5
RAMP_STEP_INTERVAL_S=15

# ── Escenario Spike ───────────────────────────────────────────────────────────
SPIKE_BASE_WORKERS=10
SPIKE_PEAK_WORKERS=80
SPIKE_BASE_BEFORE_S=30
SPIKE_PEAK_DURATION_S=30
SPIKE_BASE_AFTER_S=30

# ── Escenario Sustained ───────────────────────────────────────────────────────
# 50 workers = carga sostenida moderada para el i5-8250U.
SUSTAINED_WORKERS=50
SUSTAINED_DURATION_S=120

# Credenciales del admin (deben existir en la BD después del seed)
ADMIN_EMAIL=admin01@example.com
ADMIN_PASSWORD=TestPassword123!
